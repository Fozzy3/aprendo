  "components": [
    {
      "name": "Álbum Primary Button",
      "kind": "button",
      "refersTo": "album-button-primary",
      "description": "The one yellow action on a student screen.",
      "html": "<button class=\"ds-primary\">Empezar</button>",
      "css": ".ds-primary{font-family:Figtree,sans-serif;min-height:3rem;padding:.625rem 1.5rem;font-size:1rem;font-weight:800;background:#ffd23f;color:#10231c;border:0;border-radius:12px;box-shadow:0 4px 0 #c79a12;cursor:pointer;transition:transform 100ms cubic-bezier(.23,1,.32,1),box-shadow 100ms cubic-bezier(.23,1,.32,1),background-color 140ms ease}.ds-primary:hover{background:#ffdb66}.ds-primary:focus-visible{outline:2px solid #097d52;outline-offset:3px}.ds-primary:active{transform:translateY(3px);box-shadow:0 1px 0 #c79a12;background:#ffdb66}"
    },
    {
      "name": "Álbum Hero Button",
      "kind": "button",
      "refersTo": "album-button-hero",
      "description": "Names the missing sticker and its cost on Hoy.",
      "html": "<button class=\"ds-hero\"><span>Te falta Proporciones</span><small>Consíguela · 5 preguntas · 5 min</small></button>",
      "css": ".ds-hero{display:flex;flex-direction:column;align-items:center;gap:5px;width:100%;padding:14px;border:0;border-radius:14px;background:#ffd23f;color:#10231c;box-shadow:0 5px 0 #c79a12;cursor:pointer;transition:transform 100ms cubic-bezier(.23,1,.32,1),box-shadow 100ms cubic-bezier(.23,1,.32,1)}.ds-hero span{font-family:Anton,\"Arial Narrow\",sans-serif;font-weight:400;font-size:29px;line-height:1.05}.ds-hero small{font-family:Figtree,sans-serif;font-size:14px;font-weight:700}.ds-hero:hover{background:#ffdb66}.ds-hero:focus-visible{outline:2px solid #097d52;outline-offset:3px}.ds-hero:active{transform:translateY(3px);box-shadow:0 1px 0 #c79a12}"
    },
    {
      "name": "Álbum Secondary Button",
      "kind": "button",
      "refersTo": "album-button-secondary",
      "description": "Any action that is not the one primary.",
      "html": "<button class=\"ds-secondary\">Ver más</button>",
      "css": ".ds-secondary{font-family:Figtree,sans-serif;min-height:3rem;padding:.625rem 1.5rem;font-size:1rem;font-weight:800;background:#fff;color:#10231c;border:2px solid rgba(16,35,28,.24);border-radius:12px;cursor:pointer;transition:background-color 140ms ease}.ds-secondary:hover{background:#f4f9f6}.ds-secondary:focus-visible{outline:2px solid #097d52;outline-offset:2px}.ds-secondary:active{background:#f4f9f6}"
    },
    {
      "name": "Sticker Slots",
      "kind": "custom",
      "refersTo": "album-sticker-next",
      "description": "Earned, next and empty slots on an area field.",
      "html": "<div class=\"ds-page\"><div class=\"ds-s ds-earned\">12</div><div class=\"ds-s ds-next\">13</div><div class=\"ds-s ds-empty\">14</div></div>",
      "css": ".ds-page{display:grid;grid-template-columns:repeat(3,76px);gap:9px;padding:20px;background:#097d52}.ds-s{height:96px;padding:7px 8px;border-radius:10px;font-family:Anton,\"Arial Narrow\",sans-serif;font-weight:400;font-size:22px;line-height:1;color:#10231c;font-variant-numeric:tabular-nums;transition:transform 100ms cubic-bezier(.23,1,.32,1)}.ds-earned{background:#ffd23f}.ds-next{background:#fff;outline:4px solid #ffd23f;box-shadow:0 10px 18px rgba(0,0,0,.28);transform:rotate(-4deg) scale(1.08)}.ds-empty{background:#086e48;color:#d7ebe2;outline:2px solid #53a486;outline-offset:-2px}.ds-earned:hover,.ds-empty:hover{transform:scale(.96)}"
    },
    {
      "name": "Answer Option",
      "kind": "card",
      "refersTo": "album-solve-option",
